% blueprint-macros.sty: leanblueprint's macros for plain LaTeX (pdflatex), for Incognita papers.
%
% A paper is also the blueprint of its formalisation (AGENTS.md, section 5.2). This package lets
% the same source compile to a PDF without plasTeX:
%   \uses{l1, l2}  statement: definitions it uses (printed in grey under the statement);
%                  proof: every node it uses (printed in grey where it stands);
%   \proves{l}     links a proof to a statement placed elsewhere (printed nothing);
%   \lean{N1, N2}  Lean names of the node (in formalisation.tex; printed in grey);
%   \leanok        set by CI from the audit, never by agents: prints the green box
%                  "LEAN APPROVED" under the statement, with its Lean names;
%   \mathlibok     the node is in a dependency (Mathlib, LML, LMLExplore): a box "IN A DEPENDENCY";
%   \notready      the node is not ready for formalisation (printed in grey);
%   \discussion{n} a link to an issue (printed nothing).
% It also defines the theorem environments of a paper (option `notheorems` to skip them): one
% shared counter for definition, lemma, proposition, theorem, corollary, remark, example.
% Papers load it by a relative path, \usepackage{../../templates/paper/blueprint-macros}, which
% works from papers/<P>/ and from templates/paper/ (both two levels deep): no TEXINPUTS needed.
% There is no \ProvidesPackage, because LaTeX would warn about the relative name. Version of
% 2026-11-14. Requires LaTeX 2020-10 or later (hooks).
\NeedsTeXFormat{LaTeX2e}[2020/10/01]

\newif\ifincognita@theorems \incognita@theoremstrue
\DeclareOption{notheorems}{\incognita@theoremsfalse}
\ProcessOptions\relax

\RequirePackage{amsthm}
\RequirePackage{xcolor}

\definecolor{incognitaLean}{RGB}{0,110,40}
\definecolor{incognitaGrey}{gray}{0.42}

\newif\ifincognita@leanok
\newif\ifincognita@mathlibok
\newif\ifincognita@notready
\newif\ifincognita@inproof
\def\incognita@leannames{}
\def\incognita@uses{}

% A comma-separated list of labels, printed as "2.1 (def:grid), 3.4 (lem:tail)".
\ExplSyntaxOn
\seq_new:N \l__incognita_refs_seq
\cs_new_protected:Npn \incognita@printrefs #1
  {
    \seq_clear:N \l__incognita_refs_seq
    \exp_args:No \clist_map_inline:nn {#1}
      {
        \seq_put_right:Nn \l__incognita_refs_seq
          { \ref{##1}~(\texttt{\detokenize{##1}}) }
      }
    \seq_use:Nn \l__incognita_refs_seq { ,~ }
  }
\ExplSyntaxOff

\newcommand{\incognita@greyline}[1]{%
  \par\smallskip{\normalfont\footnotesize\color{incognitaGrey}#1\par}}

\newcommand{\lean}[1]{\def\incognita@leannames{#1}}
\newcommand{\leanok}{\incognita@leanoktrue}
\newcommand{\mathlibok}{\incognita@mathliboktrue}
\newcommand{\notready}{\incognita@notreadytrue}
\newcommand{\proves}[1]{}
\newcommand{\discussion}[1]{}
\newcommand{\uses}[1]{%
  \ifincognita@inproof
    \incognita@greyline{Uses: \incognita@printrefs{#1}}%
  \else
    \def\incognita@uses{#1}%
  \fi}

\newcommand{\incognita@leannamesline}{%
  \texttt{\detokenize\expandafter{\incognita@leannames}}}

\newcommand{\incognita@box}[1]{%
  \par\medskip
  {\normalfont\setlength{\fboxsep}{5pt}\setlength{\fboxrule}{1.2pt}%
   \noindent\fcolorbox{incognitaLean}{incognitaLean!8}{%
     \parbox{\dimexpr\linewidth-2\fboxsep-2\fboxrule\relax}{\centering
       {\color{incognitaLean}\sffamily\bfseries #1}%
       \ifx\incognita@leannames\@empty\else
         \\[2pt]{\footnotesize\incognita@leannamesline}%
       \fi}}\par}}

% Printed at the end of every statement environment, inside it.
\newcommand{\incognita@statementend}{%
  \ifx\incognita@uses\@empty\else
    \incognita@greyline{Uses: \incognita@printrefs{\incognita@uses}}%
  \fi
  \ifincognita@notready
    \incognita@greyline{Not ready for formalisation.}%
  \fi
  \ifincognita@leanok
    \incognita@box{LEAN APPROVED}%
  \else\ifincognita@mathlibok
    \incognita@box{IN A DEPENDENCY}%
  \else
    \ifx\incognita@leannames\@empty\else
      \incognita@greyline{Lean: \incognita@leannamesline\ (not verified)}%
    \fi
  \fi\fi}

\ifincognita@theorems
  \theoremstyle{plain}
  \newtheorem{theorem}{Theorem}[section]
  \newtheorem{lemma}[theorem]{Lemma}
  \newtheorem{proposition}[theorem]{Proposition}
  \newtheorem{corollary}[theorem]{Corollary}
  \theoremstyle{definition}
  \newtheorem{definition}[theorem]{Definition}
  \newtheorem{example}[theorem]{Example}
  \theoremstyle{remark}
  \newtheorem{remark}[theorem]{Remark}
\fi

\AddToHook{env/theorem/end}{\incognita@statementend}
\AddToHook{env/lemma/end}{\incognita@statementend}
\AddToHook{env/proposition/end}{\incognita@statementend}
\AddToHook{env/corollary/end}{\incognita@statementend}
\AddToHook{env/definition/end}{\incognita@statementend}
\AddToHook{env/proof/begin}{\incognita@inprooftrue}

\endinput
