module

public import Mathlib.MeasureTheory.Constructions.BorelSpace.ContinuousMap
public import Mathlib.Probability.Martingale.Basic
public import Mathlib.Topology.ContinuousMap.SecondCountableSpace
public import Mathlib.Topology.UnitInterval

/-! # The Gaussian limit game of the minimax regret

The objects of [INC-P001, Section `sec:game`, Definitions `def:alloc`, `def:limit`, `def:risk`
and the values of `def:batched`]: the canonical space, the allocations, the limit policies, their
risk, and the values `V_K`, `V_K(H)`, `B_K(Π)` and `V_K^loc`.

The arms are a finite type `α` (`K = |α|`, the paper's `[K]` with any enumeration; the values do
not depend on it, [INC-P001, Proposition `prop:four`(c)]), and `ℝ^K` is `α → ℝ`. Time is
`unitInterval = [0, 1]`.

## Main definitions

* `Incognita.StochasticBandits.LimitGame.Omega α`: the space `C([0,1], ℝ^α) × C([0,1], ℝ^α)` of
  the pairs `(X, τ)`, with the Borel σ-algebras of the compact-open topology (Mathlib's
  `ContinuousMap.measurableSpace`).
* `allocations α`: the allocations `τ`, continuous with `τ_k` nondecreasing, `τ(0) = 0`,
  `∑_k τ_k(t) = t`.
* `filtration α`: the filtration `(𝓕_t)` generated by the coordinates `(X(s), τ(s))`, `s ≤ t`.
* `IsLimitPolicy α Q`: `Q` is a limit policy.
* `likelihood α h`, `loss α h`, `risk α Q h`: `ℓ_h`, the regret `∑_k (max_i h_i - h_k) τ_k(1)`,
  and `r(Q, h) = E_Q[ℓ_h ∑_k (max_i h_i - h_k) τ_k(1)]`, in `ℝ≥0∞`.
* `value α`, `valueOn α H`, `bayesValue α Π`, `localValue α`: `V_K`, `V_K(H)`, `B_K(Π)`,
  `V_K^loc`, in `ℝ≥0∞`.

The checks of AGENTS.md §6.4 are in `Incognita.StochasticBandits.LimitGameChecks`.
-/

@[expose] public section

open MeasureTheory ProbabilityTheory

open scoped ENNReal NNReal unitInterval

namespace Incognita.StochasticBandits.LimitGame

variable (α : Type*) [Fintype α]

/-- The **canonical space** `Ω` of the limit game [INC-P001, Definition `def:alloc`]: the pairs
`(X, τ)` of continuous paths `[0, 1] → ℝ^α`, with the product of the Borel σ-algebras of the
compact-open (uniform) topology. The paper's `Ω = C₀([0,1], ℝ^K) × 𝒜` is the closed subset where
`X(0) = 0` and `τ` is an allocation; a probability on it is a probability on this space carried by
that subset (`IsLimitPolicy.ae_mem`). -/
abbrev Omega : Type _ := C(I, α → ℝ) × C(I, α → ℝ)

/-- The **allocations** `𝒜` [INC-P001, Definition `def:alloc`]: the continuous maps
`τ = (τ_k)_k : [0, 1] → ℝ^α` with each `τ_k` nondecreasing, `τ(0) = 0` and `∑_k τ_k(t) = t`. Such
a map takes its values in `[0, 1]^α`, as in the paper (`0 = τ_k(0) ≤ τ_k(t) ≤ ∑_j τ_j(t) = t`). -/
def allocations : Set C(I, α → ℝ) :=
  {τ | (∀ k, Monotone fun t ↦ τ t k) ∧ τ 0 = 0 ∧ ∀ t, ∑ k, τ t k = t}

omit [Fintype α] in
/-- The coordinate `ω ↦ (X(t), τ(t))` of the canonical space is measurable. -/
lemma measurable_coord [Finite α] (t : I) :
    Measurable fun ω : Omega α ↦ (ω.1 t, ω.2 t) :=
  ((ContinuousMap.measurable_eval t).comp measurable_fst).prodMk
    ((ContinuousMap.measurable_eval t).comp measurable_snd)

/-- The **filtration** `(𝓕_t)_{t ∈ [0, 1]}` generated by the coordinates `(X, τ)` of the canonical
space [INC-P001, Definition `def:alloc`]: `𝓕_t = σ((X(s), τ(s)), s ≤ t)`, Mathlib's natural
filtration of the coordinate process. -/
noncomputable def filtration : Filtration I (inferInstance : MeasurableSpace (Omega α)) :=
  Filtration.natural (fun t (ω : Omega α) ↦ (ω.1 t, ω.2 t))
    fun t ↦ (measurable_coord α t).stronglyMeasurable

variable [DecidableEq α]

/-- A **limit policy** [INC-P001, Definition `def:limit`]: a probability `Q` on the canonical
space, carried by `C₀([0,1], ℝ^α) × 𝒜`, under which `X` is a continuous `(𝓕_t)`-martingale with
`⟨X_k, X_j⟩ = 1{k = j} τ_k`. The brackets are written by the martingales that define them: each
`X_k` is an `(𝓕_t, Q)`-martingale, and so is `X_k X_j - 1{k = j} τ_k` for every `k, j`, that is
`X_k² - τ_k` and `X_k X_j` (`k ≠ j`). This is the characterization of [INC-P001, Lemma
`lem:g-compact`(i)] (by uniqueness of the bracket, `τ` being continuous, adapted and
nondecreasing; the processes are true martingales since `τ ≤ 1`, by Burkholder–Davis–Gundy).
The paths are continuous by definition of `Omega`. -/
structure IsLimitPolicy (Q : Measure (Omega α)) : Prop where
  isProbabilityMeasure : IsProbabilityMeasure Q
  ae_mem : ∀ᵐ ω ∂Q, ω.1 0 = 0 ∧ ω.2 ∈ allocations α
  martingale : ∀ k, Martingale (fun t ω ↦ ω.1 t k) (filtration α) Q
  martingale_mul : ∀ k j,
    Martingale (fun t ω ↦ ω.1 t k * ω.1 t j - if k = j then ω.2 t k else 0) (filtration α) Q

/-- The **likelihood** `ℓ_h = exp(⟨h, X(1)⟩ - ½ ∑_k h_k² τ_k(1))` of the local instance `h`
[INC-P001, Definition `def:risk`]. -/
noncomputable def likelihood (h : α → ℝ) (ω : Omega α) : ℝ :=
  Real.exp (∑ k, h k * ω.1 1 k - (∑ k, h k ^ 2 * ω.2 1 k) / 2)

/-- The **regret** `∑_k (max_i h_i - h_k) τ_k(1)` of the allocation of `ω` in the local instance
`h` [INC-P001, Definition `def:risk`]; `max_i h_i` is `⨆ i, h i` (`α` is finite). -/
noncomputable def loss (h : α → ℝ) (ω : Omega α) : ℝ :=
  ∑ k, ((⨆ i, h i) - h k) * ω.2 1 k

/-- The **risk** `r(Q, h) = E_Q[ℓ_h ∑_k (max_i h_i - h_k) τ_k(1)]` of a limit policy `Q` in the
local instance `h` [INC-P001, Definition `def:risk`], in `ℝ≥0∞`. The integrand is nonnegative on
the allocations, which carry a limit policy, so the lower Lebesgue integral of its `ofReal` is the
paper's expectation. -/
noncomputable def risk (Q : Measure (Omega α)) (h : α → ℝ) : ℝ≥0∞ :=
  ∫⁻ ω, ENNReal.ofReal (likelihood α h ω * loss α h ω) ∂Q

/-- The **value** of the limit game, `V_K = inf_{Q ∈ 𝒲} sup_{h ∈ ℝ^K} r(Q, h)` [INC-P001,
Definition `def:risk`], in `ℝ≥0∞`. -/
noncomputable def value : ℝ≥0∞ :=
  ⨅ (Q : Measure (Omega α)) (_ : IsLimitPolicy α Q), ⨆ h, risk α Q h

/-- The **value on a set** `H` of local instances, `V_K(H) = inf_{Q ∈ 𝒲} sup_{h ∈ H} r(Q, h)`
[INC-P001, Definition `def:batched`], in `ℝ≥0∞`. -/
noncomputable def valueOn (H : Set (α → ℝ)) : ℝ≥0∞ :=
  ⨅ (Q : Measure (Omega α)) (_ : IsLimitPolicy α Q), ⨆ h ∈ H, risk α Q h

/-- The **Bayes value** of a prior `Π` on `ℝ^K`, `B_K(Π) = inf_{Q ∈ 𝒲} ∫ r(Q, h) Π(dh)`
[INC-P001, Definition `def:risk`], in `ℝ≥0∞` (a lower Lebesgue integral). -/
noncomputable def bayesValue (prior : Measure (α → ℝ)) : ℝ≥0∞ :=
  ⨅ (Q : Measure (Omega α)) (_ : IsLimitPolicy α Q), ∫⁻ h, risk α Q h ∂prior

/-- The **local value** `V_K^loc = sup_{M > 0} V_K([-M, M]^K)` [INC-P001, Definition
`def:batched`], in `ℝ≥0∞`. -/
noncomputable def localValue : ℝ≥0∞ :=
  ⨆ (M : ℝ) (_ : 0 < M), valueOn α (Set.univ.pi fun _ ↦ Set.Icc (-M) M)

end Incognita.StochasticBandits.LimitGame
