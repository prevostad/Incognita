module

public import LMLExplore.Bandits.AsymptoticOptimality

/-! # The setting of transfer bandits with adaptively collected source data

The objects of [INC-P003, sec:setting] (paper `P003-transfer-setting`).

Before a `K`-armed bandit game, for each arm `a` a learner receives the first `N' a` values of an
i.i.d. stack drawn from a source law `ν' a`; the sizes `N'` are chosen by a *size rule*, a map
from the source space whose event `{N' = n}` depends only on the randomisation and on the values
in the box of `n`. The learner then plays `T` rounds of the bandit game `ν`, its actions being
Markov kernels of the source data and of the online history.

The source model is that of [PMRM26, Section 3.2] (prior counts chosen by an unknown adaptive
strategy, independent of the target game), with adaptive sizes given by size rules: a size rule is
a stopping point of the `K`-parameter filtration `(𝒢_n)_{n ∈ ℕ^K}` [MV81, Section 1.3].

## Conventions

* Arms are a finite type `α` with measurable singletons (the paper's `[K]`, `K = Fintype.card α`).
* A law on `[0,1]` is a probability measure on `ℝ` concentrated on `Set.Icc 0 1`; an instance is a
  Markov kernel `ν : Kernel α ℝ` (LML's bandits), with `∀ a, ∀ᵐ x ∂(ν a), x ∈ Set.Icc 0 1`.
* Stacks and rounds are indexed from `0`: the paper's value `X'_{k,j}` (`j ≥ 1`) is
  `ω.2 k (j - 1)`, the box `B(n)` is `{(k, j) | j < n k}`, the paper's round `t ≥ 1` is the round
  `t - 1`, and the online history of `T` rounds is an element of `Fin T → α × ℝ`.
* The randomisation `U'` of the paper (`[0,1]^ℕ` with the uniform law) is the first coordinate of
  the source space, with values in `unitInterval` and its `volume`.
* The source data `(N', (X'_{k,j})_{(k,j) ∈ B(N')})` of the paper, an element of the disjoint union
  `⨆_n [0,1]^{B(n)}`, is represented by the pair `(N', x)` where `x k j = X'_{k,j}` in the box and
  `x k j = 0` outside it. The map from the disjoint union to this representation is a measurable
  injection with a measurable inverse on its range, so laws, divergences and learners correspond
  (a modelling remark, not formalised).

## Main definitions

* `SourceSpace α`, `sourceMeasure ν'`: the source space `Ω'` and its law `P'_{ν'}`
  (def:source-space).
* `boxSigma n`: the σ-algebra `𝒢_n` of the randomisation and of the values in the box of `n`.
* `IsSizeRule N'`: `N'` is a size rule (def:size-rule); `IsSourceStrategy ρ` (sequences of rules).
* `Source α`, `sourceData N'`, `sourceLaw ν' N'`: the source data `D` and its law `P^D_{ν',N'}`
  (def:source-data).
* `TransferAlgorithm α`: a transfer learner (def:learner); `TransferAlgorithm.ofAlgorithm σ`: the
  source-ignoring learner of an LML bandit algorithm.
* `onlineKernel π ν T`: the kernel `κ^T_{π,ν}`; `gameMeasure ν' N' ν π T`: the law of the game
  `P^D_{ν',N'} ⊗ κ^T_{π,ν}` (def:game); `sourceCount`, `onlineCount`: `N'_k` and `N_k(T)` on it.

## Main statements

* Instances: `isProbabilityMeasure_sourceMeasure`, `isProbabilityMeasure_sourceLaw`,
  `isMarkovKernel_stepKernel`, `isMarkovKernel_onlineKernel`, `isProbabilityMeasure_gameMeasure`.
* `map_eval_sourceMeasure`, `map_fst_sourceMeasure`: under `P'_{ν'}`, `X'_{k,j}` has law `ν'_k` and
  the randomisation is uniform; `measurable_sourceData`; `TransferAlgorithm.ofAlgorithm_policy`.
-/

@[expose] public section

open MeasureTheory ProbabilityTheory Learning

open scoped ENNReal unitInterval

namespace Incognita.TransferBandits

variable {α : Type*} [MeasurableSpace α]

/-! ### The source phase -/

/-- The source space `Ω'` of [INC-P003, def:source-space]: a randomisation `ω.1 : ℕ → I` and, for
each arm `a`, a stack `ω.2 a : ℕ → ℝ` of values (index `j` is the paper's `(j + 1)`-th value). -/
abbrev SourceSpace (α : Type*) : Type _ := (ℕ → I) × (α → ℕ → ℝ)

/-- The law `P'_{ν'}` of the source space: the randomisation is uniform and independent of the
stacks, and the values of the stacks are independent, those of arm `a` with law `ν' a`. -/
noncomputable def sourceMeasure (ν' : Kernel α ℝ) : Measure (SourceSpace α) :=
  (Measure.infinitePi fun _ : ℕ ↦ (volume : Measure I)).prod
    (Measure.infinitePi fun a : α ↦ Measure.infinitePi fun _ : ℕ ↦ ν' a)

/-- The randomisation and the values of the box of `n`: `(U', (X'_{k,j})_{j < n k})`. -/
def boxRestrict (n : α → ℕ) (ω : SourceSpace α) : (ℕ → I) × ((a : α) → Fin (n a) → ℝ) :=
  (ω.1, fun a j ↦ ω.2 a j)

/-- The σ-algebra `𝒢_n` of [INC-P003, def:source-space], generated by the randomisation and the
values `X'_{k,j}` with `j < n k` (0-based). -/
@[instance_reducible]
def boxSigma (n : α → ℕ) : MeasurableSpace (SourceSpace α) :=
  MeasurableSpace.comap (boxRestrict n) inferInstance

/-- A **size rule** [INC-P003, def:size-rule]: a measurable size map `N' : Ω' → ℕ^K` such that
`{N' = n} ∈ 𝒢_n` for every `n`, that is, a stopping point of the filtration `(𝒢_n)_{n ∈ ℕ^K}`. -/
structure IsSizeRule (N : SourceSpace α → α → ℕ) : Prop where
  /-- A size map is measurable. -/
  measurable : Measurable N
  /-- The decision to stop at `n` reads only the randomisation and the values in the box of `n`. -/
  measurableSet_eq : ∀ n : α → ℕ, MeasurableSet[boxSigma n] {ω | N ω = n}

/-- A **source strategy** [INC-P003, def:size-rule]: a size rule `ρ T` for each horizon `T`. The
paper indexes horizons from `1`; the rule at horizon `0` plays no role in the statements that use
this notion (they are asymptotic in `T`). -/
def IsSourceStrategy (ρ : ℕ → SourceSpace α → α → ℕ) : Prop :=
  ∀ T, IsSizeRule (ρ T)

/-- The space `𝒮` of source data [INC-P003, def:source-data], represented as pairs `(n, x)`: the
sizes `n`, and the kept values `x k j` for `j < n k` (with `x k j = 0` outside the box). -/
abbrev Source (α : Type*) : Type _ := (α → ℕ) × (α → ℕ → ℝ)

/-- The source data `D = (N', (X'_{k,j})_{(k,j) ∈ B(N')})` of a size map `N'`
[INC-P003, def:source-data]: the sizes, and the values of the box of the sizes, the other values
being replaced by `0`. -/
def sourceData (N : SourceSpace α → α → ℕ) (ω : SourceSpace α) : Source α :=
  (N ω, fun a j ↦ if j < N ω a then ω.2 a j else 0)

/-- The law `P^D_{ν',N'}` of the source data under `P'_{ν'}`. -/
noncomputable def sourceLaw (ν' : Kernel α ℝ) (N : SourceSpace α → α → ℕ) : Measure (Source α) :=
  (sourceMeasure ν').map (sourceData N)

/-! ### Learners and the law of the game -/

/-- A **transfer learner** [INC-P003, def:learner]: for each round `n` (0-based; the paper's
round `n + 1`), a Markov kernel from the source data and the online history of the `n` previous
rounds to the arms. For each source data `s`, `fun n h ↦ policy n (s, h)` is a bandit algorithm. -/
structure TransferAlgorithm (α : Type*) [MeasurableSpace α] where
  /-- Law of the action of round `n` given the source data and the first `n` rounds. -/
  policy : (n : ℕ) → Kernel (Source α × (Fin n → α × ℝ)) α
  /-- The policy is a Markov kernel. -/
  [isMarkovKernel_policy : ∀ n, IsMarkovKernel (policy n)]

attribute [instance] TransferAlgorithm.isMarkovKernel_policy

/-- The online history of LML (rounds with a trivial observation) as a sequence of pairs
(action, reward). -/
def histPairs {n : ℕ} (h : Hist Unit α ℝ n) : Fin n → α × ℝ :=
  fun i ↦ ((h i).action, (h i).feedback)

/-- The sequence of pairs (action, reward) as an LML history with trivial observations. -/
def pairsHist {n : ℕ} (h : Fin n → α × ℝ) : Hist Unit α ℝ n :=
  fun i ↦ ((), (h i).1, (h i).2)

@[fun_prop]
lemma measurable_pairsHist (n : ℕ) : Measurable (pairsHist (α := α) (n := n)) := by
  unfold pairsHist
  fun_prop

/-- The **source-ignoring learner** `π^σ` of a bandit algorithm `σ = alg` of LML
[INC-P003, def:learner]: `π^σ_t(s, h) = σ_t(h)`. -/
noncomputable def TransferAlgorithm.ofAlgorithm (alg : Algorithm Unit α ℝ) :
    TransferAlgorithm α where
  policy n := (alg.policy n).comap (fun p ↦ (pairsHist p.2, ())) (by fun_prop)

/-- The law of the round `n` (action, reward) given the source data and the first `n` rounds:
the action is drawn from the policy, and the reward from `ν` at the action, that is,
`(π_n ⊗ ν)(s, h) = ∫ π_n((s, h), da) δ_a ⊗ ν_a`. -/
noncomputable def stepKernel (π : TransferAlgorithm α) (ν : Kernel α ℝ) (n : ℕ) :
    Kernel (Source α × (Fin n → α × ℝ)) (α × ℝ) :=
  π.policy n ⊗ₖ ν.comap Prod.snd measurable_snd

/-- The kernel `κ^T_{π,ν}` [INC-P003, def:game]: the law of the online history of `T` rounds
of the learner `π` against the bandit `ν`, given the source data. It is the iterated composition
product `Q^t = Q^{t-1} ⊗ (π_t ⊗ ν)`, from the Dirac mass at the empty history. -/
noncomputable def onlineKernel (π : TransferAlgorithm α) (ν : Kernel α ℝ) :
    (T : ℕ) → Kernel (Source α) (Fin T → α × ℝ)
  | 0 => Kernel.deterministic (fun _ ↦ Fin.elim0) measurable_const
  | T + 1 => (onlineKernel π ν T ⊗ₖ stepKernel π ν T).map
      (MeasurableEquiv.finSuccProd (α × ℝ) T).symm

/-- The **law of the game** at horizon `T` [INC-P003, def:game]:
`P^T_{ν',N',ν,π} = P^D_{ν',N'} ⊗ κ^T_{π,ν}` on the pairs (source data, online history). -/
noncomputable def gameMeasure (ν' : Kernel α ℝ) (N : SourceSpace α → α → ℕ) (ν : Kernel α ℝ)
    (π : TransferAlgorithm α) (T : ℕ) : Measure (Source α × (Fin T → α × ℝ)) :=
  sourceLaw ν' N ⊗ₘ onlineKernel π ν T

/-- The size `N'_a` of the source sample of arm `a`, read on the source data. -/
def sourceCount (a : α) (s : Source α) : ℕ := s.1 a

/-- The number `N_a(T)` of pulls of arm `a` in an online history of `T` rounds. -/
noncomputable def onlineCount {T : ℕ} (a : α) (h : Fin T → α × ℝ) : ℕ :=
  by classical exact (Finset.univ.filter fun i ↦ (h i).1 = a).card

/-! ### Instances and basic API -/

instance isProbabilityMeasure_sourceMeasure (ν' : Kernel α ℝ) [IsMarkovKernel ν'] :
    IsProbabilityMeasure (sourceMeasure ν') := by
  unfold sourceMeasure
  infer_instance

/-- Under `P'_{ν'}`, the value `X'_{k,j}` has law `ν'_k`. -/
lemma map_eval_sourceMeasure (ν' : Kernel α ℝ) [IsMarkovKernel ν'] (k : α) (j : ℕ) :
    (sourceMeasure ν').map (fun ω : SourceSpace α ↦ ω.2 k j) = ν' k := by
  have h : (fun ω : SourceSpace α ↦ ω.2 k j) =
      (fun w : ℕ → ℝ ↦ w j) ∘ (fun z : α → ℕ → ℝ ↦ z k) ∘ Prod.snd := rfl
  rw [h, ← Measure.map_map (by fun_prop) (by fun_prop),
    ← Measure.map_map (by fun_prop) measurable_snd, sourceMeasure, Measure.map_snd_prod,
    measure_univ, one_smul, Measure.infinitePi_map_eval, Measure.infinitePi_map_eval]

/-- Under `P'_{ν'}`, the randomisation has the uniform law `volume^{⊗ℕ}`, whatever `ν'`. -/
lemma map_fst_sourceMeasure (ν' : Kernel α ℝ) [IsMarkovKernel ν'] :
    (sourceMeasure ν').map Prod.fst = Measure.infinitePi fun _ : ℕ ↦ (volume : Measure I) := by
  rw [sourceMeasure, Measure.map_fst_prod, measure_univ, one_smul]

omit [MeasurableSpace α] in
lemma measurable_sourceData {N : SourceSpace α → α → ℕ} (hN : Measurable N) :
    Measurable (sourceData N) := by
  refine hN.prodMk (measurable_pi_iff.mpr fun a ↦ measurable_pi_iff.mpr fun j ↦ ?_)
  refine Measurable.ite ?_ ((measurable_pi_apply j).comp ((measurable_pi_apply a).comp
    measurable_snd)) measurable_const
  exact measurableSet_lt measurable_const ((measurable_pi_apply a).comp hN)

instance isProbabilityMeasure_sourceLaw (ν' : Kernel α ℝ) [IsMarkovKernel ν']
    (N : SourceSpace α → α → ℕ) : IsProbabilityMeasure (sourceLaw ν' N) := by
  unfold sourceLaw
  infer_instance

/-- Known case: the source-ignoring learner of an LML algorithm plays, at every round, the policy
of that algorithm on the online history. -/
lemma TransferAlgorithm.ofAlgorithm_policy (alg : Learning.Algorithm Unit α ℝ) (n : ℕ)
    (s : Source α) (h : Fin n → α × ℝ) :
    (TransferAlgorithm.ofAlgorithm alg).policy n (s, h) = alg.policy n (pairsHist h, ()) := rfl

instance isMarkovKernel_stepKernel (π : TransferAlgorithm α) (ν : Kernel α ℝ) [IsMarkovKernel ν]
    (n : ℕ) : IsMarkovKernel (stepKernel π ν n) := by
  unfold stepKernel
  infer_instance

instance isMarkovKernel_onlineKernel (π : TransferAlgorithm α) (ν : Kernel α ℝ)
    [IsMarkovKernel ν] : ∀ T, IsMarkovKernel (onlineKernel π ν T)
  | 0 => by
    unfold onlineKernel
    infer_instance
  | T + 1 => by
    have := isMarkovKernel_onlineKernel π ν T
    unfold onlineKernel
    exact Kernel.IsMarkovKernel.map _ (MeasurableEquiv.measurable _)

/-- Witness: for instances that are Markov kernels, the law of the game is a probability
measure. -/
instance isProbabilityMeasure_gameMeasure (N : SourceSpace α → α → ℕ) (ν' ν : Kernel α ℝ)
    [IsMarkovKernel ν'] [IsMarkovKernel ν] (π : TransferAlgorithm α) (T : ℕ) :
    IsProbabilityMeasure (gameMeasure ν' N ν π T) := by
  unfold gameMeasure
  infer_instance

end Incognita.TransferBandits
